/dts-v1/;
/plugin/;

#include "../qcom/volcano-qrd.dtsi"
#include "frogger-common.dtsi"

/*
 * Camera is disabled here, and this is deliberate -- do not re-add it without
 * reading this.
 *
 * The camera port pulled the whole platform block (qcom/camera/volcano-camera.dtsi
 * -- cci, csiphy, icp, bps, smmu, the cam_sensor_* pinctrl) into this overlay,
 * because the base volcano.dtb carries no camera block and the sensor nodes
 * could not otherwise resolve &cam_cci0/1. That produced a dtbo the device will
 * not boot with at all: bisected on hardware against a known-good state, with
 * only the dtbo changing, our dtbo fails to boot even into recovery while
 * stock's boots fine.
 *
 * Stock's overlay contains sensors only, because its base device tree already
 * provides the platform block. Duplicating that block in the overlay is
 * evidently not equivalent -- it most likely collides with, rather than extends,
 * what the bootloader expects.
 *
 * The sensor nodes themselves are untested and may be perfectly fine; they were
 * never reached. frogger-camera-sensor.dtsi is kept in the tree for when the
 * platform half is solved properly.
 */

/ {
	model = "Nothing Phone (4a)";
	qcom,msm-id = <636 0x10000>;
	qcom,board-id = <11 0>;
	qcom,oem-id = <1>;
};
